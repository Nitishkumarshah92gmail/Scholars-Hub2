# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL (your deployed backend URL)
VITE_API_URL=https://your-backend-url/api

# Canonical origin that owns the auth session. Any other origin the frontend is
# served from (e.g. the scholarshub.qd.je custom domain) is redirected here,
# which then shows /dashboard for signed-in users or /login for signed-out ones.
VITE_CANONICAL_ORIGIN=https://scholars-hub2-1.onrender.com

# OpenRouter API Key (for AI ChatBot)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# YouTube API Key (for video embeds)
VITE_YOUTUBE_API_KEY=your_youtube_api_key
